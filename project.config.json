{
  "appid": "touristappid",
  "compileType": "miniprogram",
  "libVersion": "3.15.3",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tmp"
      },
      {
        "type": "folder",
        "value": "backend"
      },
      {
        "type": "folder",
        "value": "skill"
      },
      {
        "type": "folder",
        "value": ".codegraph"
      },
      {
        "type": "folder",
        "value": ".understand-anything"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": "THIRD_PARTY_NOTICES.md"
      },
      {
        "type": "file",
        "value": "THIRD_PARTY_LICENSES.md"
      },
      {
        "type": "file",
