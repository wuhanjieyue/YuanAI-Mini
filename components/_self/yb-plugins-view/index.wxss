@import '/static_wxss/skyfontline.wxss';
@import "/static_wxss/skyother.wxss";
@import "/static_wxss/asset-cards.wxss";
@import '/static_wxss/skycolor.wxss';

.plugins-page {
  position: relative;
  overflow: hidden;
}
.plugins-scroll { width: 100%; height: 100%; }
.plugins-installed-scroll { width: 100%; height: 150rpx; display: flex; flex-direction: row; }
.plugins-installed-edge { width: 18rpx; flex-shrink: 0; }
.plugin-installed-item { padding: 30rpx 12rpx; flex-shrink: 0; }
.plugin-pressed { opacity: 0.7; }
.plugins-heading {
  padding: 60rpx 30rpx 20rpx;
  line-height: 42rpx;
}
.plugin-row {
  padding: 30rpx;
}
.plugin-icon {
  display: flex;
  width: 90rpx;
  height: 90rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border: 2rpx solid var(--border-subtle, #EAE8E7);
  border-radius: 20rpx;
  overflow: hidden;
}
.plugin-logo { width: 100%; height: 100%; }
.plugin-copy { flex: 1; min-width: 0; padding-left: 30rpx; }
.plugin-title {
  display: block;
  line-height: 44rpx;
}
.plugin-description {
  display: block;
  padding-top: 4rpx;
  line-height: 36rpx;
}
.plugin-action {
  display: flex;
  width: 76rpx;
  height: 90rpx;
  flex-shrink: 0;
}
.plugin-action-host { width: 76rpx; flex-shrink: 0; }
.plugin-action-loading { animation: plugin-action-spin 1.5s linear infinite; }
@keyframes plugin-action-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.plugin-menu-divider {
  height: 2rpx;
  margin-top: 12rpx;
  margin-bottom: 12rpx;
  background-color: var(--border-subtle, #EAE8E7);
}
.plugin-skeleton-title { width: 54%; height: 32rpx; border-radius: 10rpx; }
.plugin-skeleton-description {
  width: 86%;
  height: 24rpx;
}
.plugins-status {
  padding: 30rpx;
  font-size: 26rpx;
}
.plugins-empty-overlay { bottom: 154rpx; }
.plugins-bottom-space { height: 154rpx; }
.plugins-search-row { position: absolute; left: 7%; right: 7%; bottom: 42rpx; height: 96rpx; z-index: 20; }
