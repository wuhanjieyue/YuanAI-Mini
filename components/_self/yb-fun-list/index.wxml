<view class="fun-box jc">
  <view>
    <view wx:if="{{skill}}" class="feature-chip plr16 accent-user-bubble tc ac xlradius">
      <image class="feature-logo sradius" src="{{skill.logoUrl}}" mode="aspectFill" aria-hidden="true" />
      <view class="feature-label plr16 ft28"><text max-lines="1" overflow="ellipsis">{{skillTitle}}</text></view>
      <text class="close-icon ft32 iconfont icon-x" catch:tap="closeFun" aria-role="button" aria-label="{{i18n.archive.close}}"></text>
    </view>
    <view wx:if="{{thinking}}" class="feature-chip plr16 accent-user-bubble tc ac xlradius" bind:tap="startThink">
      <image class="feature-logo sradius" src="{{featureLogos.thinking}}" mode="aspectFill" aria-hidden="true" />
      <view class="feature-label plr16 ft28 think-text">
        <text>{{thinkingName}}</text>
      </view>
      <text class="close-icon ft32 iconfont icon-x" catch:tap="closeFun"></text>
    </view>

    <view wx:if="{{searching}}" class="feature-chip plr16 accent-user-bubble tc ac xlradius" bind:tap="startSearch">
      <image class="feature-logo sradius" src="{{featureLogos.searching}}" mode="aspectFill" aria-hidden="true" />
      <view class="feature-label plr16 ft28 search-text">
        <text>{{searchingName}}</text>
      </view>
      <text class="close-icon ft32 iconfont icon-x" catch:tap="closeFun"></text>
    </view>

    <view wx:if="{{imging}}" class="feature-chip plr16 accent-user-bubble tc ac xlradius" bind:tap="startImage">
      <image class="feature-logo sradius" src="{{featureLogos.imging}}" mode="aspectFill" aria-hidden="true" />
      <view class="feature-label plr16 ft28 image-text">
        <text>{{imgingName}}</text>
      </view>
      <text class="close-icon ft32 iconfont icon-x" catch:tap="closeFun"></text>
    </view>

    <view wx:if="{{studying}}" class="feature-chip plr16 accent-user-bubble tc ac xlradius">
      <image class="feature-logo sradius" src="{{featureLogos.studying}}" mode="aspectFill" aria-hidden="true" />
      <view class="feature-label plr16 ft28">
        <text>{{studyingName}}</text>
      </view>
      <text class="close-icon ft32 iconfont icon-x" catch:tap="closeFun"></text>
    </view>
  </view>

</view>
