@import '/static_wxss/skyfontline.wxss';
@import '/static_wxss/skeleton.wxss';
@import '/static_wxss/skycolor.wxss';
@import '/static_wxss/skyother.wxss';

:host{
  display: block;
}
.recommendations {
  pointer-events: none;
  opacity: 0;
  transform: scaleY(0.8);
  transform-origin: 0% 100%;
  padding-top: 0;
}
.recommendation {
  flex: 1;
  min-width: 0;
  line-height: 88rpx;
}
.recommendation-row {
  display: flex;
  min-height: 88rpx;
}
.recommendation-skeleton {
  height: 30rpx;
}
.refresh-button {
  flex: 0 0 64rpx;
  padding: 12rpx;
  margin: -12rpx;
  display: flex;
}

.recommendations-visible{
  pointer-events: auto;
}
