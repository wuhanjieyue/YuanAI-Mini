<root-portal>
  <view class="notice-origin" aria-hidden="true"></view>
  <view class="floating-search xlradius notice-capsule {{visible ? '' : 'notice-capsule-hidden'}} {{closing ? 'notice-capsule-closing' : ''}}"
    style="{{themeStyle}};top:{{noticeTop}}px;left:{{noticeLeft}}px;height:{{heightRpx}}rpx;" aria-role="{{alert ? 'alert' : 'status'}}" aria-label="{{message}}" aria-hidden="{{!visible || closing}}">
    <slot name="prefix"></slot>
    <view class="notice-content">
      <block wx:if="{{!customContent}}">
        <text wx:if="{{closable}}" class="notice-text ft28 text-l0" max-lines="1" overflow="ellipsis">{{message}}</text>
        <text wx:else class="ft28 text-l0">{{message}}</text>
      </block>
      <slot wx:else></slot>
    </view>
    <view wx:if="{{closable}}" class="notice-close text-l0" catch:tap="close" aria-role="button" aria-label="{{closeLabel || '关闭'}}">×</view>
    <slot name="suffix" wx:else></slot>
  </view>
</root-portal>
