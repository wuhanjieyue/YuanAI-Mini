@import '../_shared/iconfont.wxss';
@import '/static_wxss/skycolor.wxss';
@import '/static_wxss/skyother.wxss';


.icon-x::before {
  content: "\e78f";
}
.file-scroll {
  width: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.attachment-item,
.attachment-preview,
.file-icon-area{
  position: relative;
}
.image-item{
    width: 80px;height: 80px;
    background-color: var(--surface-subtle, #f0f0f0);
}
.file-item {
  width: 180px;
  height: 80px;
  display: flex;
  flex-direction: row;
}
.file-icon-area {
  width: 96rpx;
  height: 80px;
  flex: 0 0 96rpx;
  display: flex;
  flex-direction: column;
}
.file-icon-image {
  font-size: 100rpx;
  line-height: 1;
}
.upload-loading-mask {
  left: 0;
  background: var(--glass-56, rgba(255, 255, 255, 0.56));
  overflow: hidden;
}
.upload-loading-shimmer{
    position: absolute;
    top: -100%;
    left: -200%;
    width: 200%;
    height: 300%;
    pointer-events: none;
    background-image: linear-gradient(126deg, transparent 36%, var(--glass-56, rgba(255, 255, 255, 0.56)) 50%, transparent 64%);
    animation: upload-loading-sweep 1.8s linear infinite;
}
@keyframes upload-loading-sweep{
    from{ transform: translateX(0); }
    to{ transform: translateX(200%); }
}
.file-meta {
  flex: 2;
}
.delete-button {
  width: 46rpx;
  height: 46rpx;
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  display: flex;
  flex-direction: column;
}
