@import "/static_wxss/asset-cards.wxss";
@import '/static_wxss/skycolor.wxss';
@import '/static_wxss/skyother.wxss';
@import '/static_wxss/skyfontline.wxss';

.knowledge-chunks-page { background-color: var(--bg-gray); }
.knowledge-chunk-row { width: 100%; }
.knowledge-chunk-label { flex: 1; min-width: 0; line-height: 44rpx; }
.knowledge-chunk-skeleton-label { height: 44rpx; border-radius: 8rpx; }
.knowledge-chunk-skeleton-arrow { width: 36rpx; height: 36rpx; border-radius: 8rpx; }
.knowledge-chunk-line { width: 100%; height: 1rpx; }
.knowledge-chunks-state { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
