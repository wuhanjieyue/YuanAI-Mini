@import "/static_wxss/asset-cards.wxss";

.archive-toolbar {
  display: flex;
  flex-shrink: 0;
  min-height: 128rpx;
  box-sizing: border-box;
}
.archive-toolbar-side{
  width: 160rpx;
  flex-shrink: 0;
  display: flex;
}
.archive-toolbar-title {
  flex: 1;
  min-width: 0;
  margin: 0 12rpx;
}
.archive-messages{
  width: 100%;
  height: 0;
  flex: 1;
  min-height: 0;
}
.archive-message {
  padding-top: 12rpx;
  box-sizing: border-box;
}
.archive-user {
  display: flex;
  flex-direction: column;
}
.archive-user-bubble {
  max-width: 82%;
  margin-top: 12rpx;
  padding-right: 30rpx;
  padding-left: 30rpx;
  border-radius: 28rpx;
  line-height: 1.6;
}

.archive-skeleton-user { width: 50%; height: 52rpx; }
.archive-skeleton-line { height: 44rpx; border-radius: 8rpx; }
