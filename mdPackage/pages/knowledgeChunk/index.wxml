<page-meta page-style="{{themeStyle}}" background-color="{{themeBackground}}" root-background-color="#ffffff00" />
<view class="info-page" style="{{themeStyle}};{{accentStyle}};visibility:{{themeStyle ? 'visible' : 'hidden'}}">
  <view class="info-toolbar">
    <view class="info-header-side"></view>
    <text class="info-title ft36" max-lines="1" overflow="ellipsis">{{title || i18n.knowledge.chunk}}</text>
    <view class="info-header-side dr ac je">
      <view class="info-header-side dc ac jc glass-view cradius" bind:tap="closePage" aria-role="button" aria-label="{{i18n.archive.close}}">
        <text class="iconfont icon-x ft48 text-l0"></text>
      </view>
    </view>
  </view>
  <scroll-view class="info-scroll" scroll-y type="list" associative-container="pop-gesture" show-scrollbar="{{false}}">
    <view class="info-article" list-item>
      <view wx:if="{{loading}}" aria-hidden="true">
        <view wx:for="{{[100, 100, 100, 64]}}" wx:key="index" class="knowledge-chunk-skeleton-line skeleton-clip" style="width:{{item}}%;"><view class="skeleton-shimmer"></view></view>
      </view>
      <view wx:elif="{{failed}}" class="asset-failure-state" bind:tap="loadChunk" aria-role="button" aria-label="{{i18n.common.retry}}"><image class="asset-empty-logo" src="/static/logs/glog.png" mode="aspectFit" aria-hidden="true" /><text class="asset-empty-copy">{{error}} · {{i18n.common.retry}}</text></view>
      <towxml wx:elif="{{article}}" nodes="{{article}}" openTyper="{{false}}" theme="{{effectiveTheme}}" />
    </view>
  </scroll-view>
</view>
<yb-notice-capsule id="errorNotice" notice="{{errorNotice}}" duration="{{2500}}" closable="{{true}}" alert="{{true}}" theme-style="{{themeStyle}};{{accentStyle}}" close-label="{{i18n.common.close}}" />
