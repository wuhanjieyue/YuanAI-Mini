@import "/static_wxss/asset-cards.wxss";
@import '/static_wxss/skycolor.wxss';
@import '/static_wxss/skyfontline.wxss';
@import '/static_wxss/skyother.wxss';

page { background-color: transparent; }

.skill-sheet { position: absolute; bottom: 0; width: 100%; }
.skill-scroll {
  width: 100%;
  height: 100%;
  border-radius: 32px 32px 0 0;
  overflow: hidden;
}
.skill-header {
  display: flex;
  flex-direction: row;
  padding-top: 40rpx;
  padding-bottom: 28rpx;
}
.skill-logo {
  width: 90rpx;
  height: 90rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border: 2rpx solid var(--border-subtle);
  border-radius: 20rpx;
  overflow: hidden;
}
.skill-logo-image { width: 100%; height: 100%; }
.skill-skeleton-title { height: 48rpx; border-radius: 8rpx; }
.skill-skeleton-description { height: 36rpx; border-radius: 8rpx; }
.skill-copy {
  flex: 1;
  min-width: 0;
  padding-top: 0;
  padding-right: 104rpx;
  padding-bottom: 0;
}
.skill-title {
  display: block;
  font-size: 34rpx;
  line-height: 46rpx;
}
.skill-description {
  display: block;
  font-size: 26rpx;
  line-height: 38rpx;
}
.skill-update-time {
  padding-top: 12rpx;
  padding-bottom: 0;
  line-height: 36rpx;
}
.skill-article {
  padding-bottom: 0;
}
.skill-markdown-frame {
  border: 2rpx solid var(--border-subtle);
  border-radius: 20rpx;
}
.skill-footer-space { height: calc(144rpx + env(safe-area-inset-bottom)); }
.skill-status {
  min-height: 220rpx;
  padding-top: 100rpx;
  padding-bottom: 40rpx;
}
.skill-retry {
  color: var(--accent-action-bg);
}
.skill-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 22rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
}
.skill-close-icon { width: 48rpx; height: 48rpx; line-height: 48rpx; }
.skill-delete { right: 132rpx; }
.skill-copy-deletable { padding-right: 212rpx; }
.skill-footer {
  position: absolute;
  width: 100%;
  box-sizing: border-box;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 100rpx calc(24rpx + env(safe-area-inset-bottom));
  background: transparent;
}
.skill-try-button {
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: var(--accent-action-bg);
  color: var(--accent-action-text);
  line-height: 96rpx;
}
.skill-try-button-disabled { opacity: 0.5; }
.skill-try-loading { animation: skill-try-spin 1.5s linear infinite; }
@keyframes skill-try-spin { to { transform: rotate(360deg); } }
