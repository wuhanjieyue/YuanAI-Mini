/**代码高亮样式**/
@import "../../parse/highlight/style/github.wxss";
/*正文样式*/
.h2w-light {
  color: var(--text);
  background-color: transparent;
}

/**标题**/
.h2w-light .h2w__h1,
.h2w-light .h2w__h2 {
  border-color: var(--border-subtle);
}

/**表格**/
.h2w-light .h2w__thead .h2w__tr {
  background-color: var(--bg-l1);
}
.h2w-light .h2w__table .h2w__tr:nth-child(2n) {
  background-color: var(--bg-l0);
}
.h2w-light .h2w__th,
.h2w-light .h2w__td {
  border-color: var(--border-subtle);
}

/**代码块**/
.h2w-light .h2w__pre {
  background-color: var(--bg-l1);
  border-color: var(--accent-soft-bg);
}

.h2w-light .h2w__pre .h2w__code {
  background-color: transparent;
}

.h2w-light .h2w__code {
  background-color: var(--bg-l1);
  border-color: var(--border-subtle);
}

/**块元素**/
.h2w-light .h2w__blockquote {
  border-left-color: var(--border-subtle);
  background: var(--bg-l1);
}

/**内连元素**/
.h2w-light .h2w__a {
  color: var(--accent-link);
  text-decoration-color: var(--accent-link);
}

.h2w-light .h2w__hr {
  background-color: var(--border-subtle);
}

.h2w-light .h2w__mark {
  background: yellow;
  color: #171717;
}

.h2w-light .h2w__lineNum {
  color: var(--text-l2);
}
