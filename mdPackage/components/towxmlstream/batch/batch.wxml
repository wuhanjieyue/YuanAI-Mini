<block wx:for="{{batchNodes}}" wx:for-index="i" wx:for-item="item" wx:key="i">
	<block wx:if="{{item.tag===undefined}}">
	    <typable-text text="{{item.text}}" context-id="{{contextId}}"/>
	  </block>
	<block wx:elif="{{item.tag==='br'}}">
		<text class="{{item.attrs.class}}" style="{{item.attrs.style}}">{{item.text}}</text>
	</block>
	<block wx:elif="{{item.tag==='span'}}">
		<span data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
			<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
		</span>
	</block>
	<block wx:elif="{{item.tag==='scroll-view'}}">
		<view class="{{item.attrs.class}}" style="{{item.attrs.style}}">
			<view class="h2w__preHeader dr ac jb">
				<text class="ft24">{{item.codeLanguage}}</text>
				<text class="iconfont icon-copy ft28" data-code="{{item.codeText}}" catch:tap="copyCode" aria-role="button" aria-label="复制代码"></text>
			</view>
			<scroll-view scroll-x="{{true}}" clip="{{false}}" enable-passive="{{true}}" class="h2w__preScroll" data-data="{{item}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="min-height:{{item.scrollMinHeight}}rpx;" catch:tap="_tap">
				<view class="h2w__preContent">
					<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
				</view>
			</scroll-view>
		</view>
	</block>
	<block wx:elif="{{item.codeLines}}">
		<view data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
			<view wx:for="{{item.codeLines}}" wx:for-index="lineIndex" wx:for-item="line" wx:key="lineIndex" class="h2w__codeLine">
				<span class="h2w__codeLineText">
					<text wx:for="{{line.tokens}}" wx:for-index="tokenIndex" wx:for-item="token" wx:key="tokenIndex" class="{{token.class}}">{{token.text}}</text>
				</span>
			</view>
		</view>
	</block>
	<block wx:elif="{{item.tag==='view'}}">
		<block wx:if="{{item.rely}}">
				<view data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
					<block wx:if="{{item.listMarker}}">
						<text class="h2w__listMarker">{{item.listMarker}}</text>
						<view class="h2w__liContent">
							<span wx:if="{{item.inlineContent}}" class="h2w__inlineContent">
								<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
							</span>
							<block wx:else>
								<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
							</block>
						</view>
					</block>
					<block wx:else>
						<span wx:if="{{item.inlineContent}}" class="h2w__inlineContent">
							<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
						</span>
						<block wx:else>
							<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
						</block>
					</block>
				</view>
		</block>
		<block wx:else>
			<view class="h2w__viewParent" >
				<view data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
					<span wx:if="{{item.inlineContent}}" class="h2w__inlineContent">
						<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
					</span>
					<block wx:else>
						<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
					</block>
				</view>
			</view>
		</block>
	</block>
	<block wx:elif="{{item.tag==='video'}}">
		<view class="h2w__videoParent">
			<video data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap" poster="{{item.attrs.poster}}" src="{{item.attrs.src}}">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</video>
		</view>
	</block>
	<block wx:elif="{{item.tag==='text'}}">
		<view class="h2w__textParent">
			<block wx:if="{{item.textPlain}}">
				<text data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">{{item.textValue}}</text>
			</block>
			<block wx:else>
				<text data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
					<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
				</text>
			</block>
		</view>
	</block>
	<block wx:elif="{{item.tag==='image'}}">
		<view class="h2w__imageParent">
			<image data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap" src="{{item.attrs.src}}" mode="{{item.attrs.mode ? item.attrs.mode : 'widthFix'}}" lazy-load="{{item.attrs['lazy-load']}}">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</image>
		</view>
	</block>
	<block wx:elif="{{item.tag==='navigator'}}">
			<span class="h2w__navigatorParent">
				<navigator data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap" url="{{item.attrs.href}}">
					<text wx:if="{{item.navigatorPlain}}">{{item.navigatorText}}</text>
					<decode theme="{{theme}}" wx:else nodes="{{item}}" context-id="{{contextId}}"/>
				</navigator>
			</span>
	</block>
	<block wx:elif="{{item.tag==='swiper'}}">
		<view class="h2w__swiperParent">
			<swiper data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</swiper>
		</view>
	</block>
	<block wx:elif="{{item.tag==='swiper-item'}}">
		<view class="h2w__swiper-itemParent">
			<swiper-item data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</swiper-item>
		</view>
	</block>
	<block wx:elif="{{item.tag==='block'}}">
		<view class="h2w__blockParent">
			<block data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</block>
		</view>
	</block>
	<block wx:elif="{{item.tag==='form'}}">
		<view class="h2w__formParent">
			<form data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</form>
		</view>
	</block>
	<block wx:elif="{{item.tag==='input'}}">
		<view class="h2w__inputParent">
			<input data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</input>
		</view>
	</block>
	<block wx:elif="{{item.tag==='textarea'}}">
		<view class="h2w__textareaParent">
			<textarea data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</textarea>
		</view>
	</block>
	<block wx:elif="{{item.tag==='button'}}">
		<view class="h2w__buttonParent">
			<button data-data="{{item}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</button>
		</view>
	</block>
	<block wx:elif="{{item.tag==='checkbox-group'}}">
		<view class="h2w__checkbox-groupParent">
			<checkbox-group data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap" catch:change="_change" bindchange="{{item.attrs.bindchange}}">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</checkbox-group>
		</view>
	</block>
	<block wx:elif="{{item.tag==='checkbox'}}">
		<view class="h2w__checkboxParent">
			<checkbox data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap" checked="{{item.attrs.checked}}" value="{{item.attrs.value}}">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</checkbox>
		</view>
	</block>
	<block wx:elif="{{item.tag==='radio-group'}}">
		<view class="h2w__radio-groupParent">
			<radio-group data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</radio-group>
		</view>
	</block>
	<block wx:elif="{{item.tag==='radio'}}">
		<view class="h2w__radioParent">
			<radio data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" id="{{item.attrs.id}}" style="{{item.attrs.style}}" catch:tap="_tap" checked="{{item.attrs.checked}}">
				<decode theme="{{theme}}" wx:if="{{item.children}}" nodes="{{item}}" context-id="{{contextId}}"/>
			</radio>
		</view>
	</block>
	<block wx:elif="{{item.tag==='rich-text'}}">
					<scroll-view scroll-x="{{true}}" enable-flex="{{true}}" enable-passive="{{true}}" class="h2w__rich-textParent">
					<rich-text data-data="{{item}}" class="{{item.attrs.class}}" data="{{item.attrs.data}}" style="{{item.attrs.style}}" catch:tap="_tap" nodes="{{item.children}}"/>
				</scroll-view>
	</block>
	<block wx:elif="{{item.tag==='audio-player'}}">
		<audio-player data="{{item}}" data-data="{{item}}" catch:tap="_tap"/>
	</block>
	<block wx:elif="{{item.tag==='echarts'}}">
		<echarts data="{{item}}" data-data="{{item}}" theme="{{theme}}" catch:tap="_tap"/>
	</block>
	<block wx:elif="{{item.tag==='latex'}}">
		<latex data="{{item}}" data-data="{{item}}" theme="{{theme}}" catch:tap="_tap"/>
	</block>
	<block wx:elif="{{item.tag==='table'}}">
		<table data="{{item}}" data-data="{{item}}" context-id="{{contextId}}" catch:tap="_tap"/>
	</block>
	<block wx:elif="{{item.tag==='todogroup'}}">
		<todogroup data="{{item}}" data-data="{{item}}" context-id="{{contextId}}" catch:tap="_tap"/>
	</block>
	<block wx:elif="{{item.tag==='yuml'}}">
		<yuml data="{{item}}" data-data="{{item}}" theme="{{theme}}" catch:tap="_tap"/>
	</block>
	<block wx:elif="{{item.tag==='img'}}">
		<img data="{{item}}" data-data="{{item}}" theme="{{theme}}" catch:tap="_tap"/>
	</block>
</block>
