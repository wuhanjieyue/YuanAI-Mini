<view class="h2w wt4 ft32 h2w-{{theme}}" catch:codecopy="copyText" catch:linkcopy="copyText">
	<yb-notice-capsule id="copyNotice" duration="{{2500}}" closable="{{true}}" theme-style="{{copyNoticeTheme}}" close-label="{{copyCloseLabel}}" />
	<view class="h2w__main">
		<block wx:if="{{openTyper}}">
			<block wx:for="{{batchIds}}" wx:for-index="i" wx:for-item="item" wx:key="i">
				<batch theme="{{theme}}" batchId="{{item}}" context-id="{{contextId}}"/>
			</block>
		</block>
		<decode theme="{{theme}}" wx:else nodes="{{staticNodes}}" stream-mode="{{openTyper}}" context-id="{{contextId}}"/>
	</view>
</view>
