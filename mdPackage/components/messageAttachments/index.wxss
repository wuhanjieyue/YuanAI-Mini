.message-attachments,
.attachment-files {
  gap: 8px;
}
.attachment-file-row {
  width: 70vw;
  min-height: 64px;
  padding: 12px 16px;
  gap: 12px;
}

.attachment-file-icon {
  flex-shrink: 0;
}

.attachment-icon-text {
  color: var(--warn-l2);
}

.attachment-icon-other {
  color: var(--suc-l1);
}

.attachment-file-info {
  min-width: 0;
  flex: 1;
}
.attachment-file-name {
  width: 100%;
}

.attachment-images {
  width: 168px;
  flex-wrap: wrap;
  gap: 8px;
}

.attachment-image {
  width: 80px;
  height: 80px;
  flex-shrink: 0;
  overflow: hidden;
}
.attachment-image-empty {
  width: 100%;
  height: 100%;
  display: flex;
}
.delivery-attachments {
  align-items: stretch;
  margin-top: 44rpx;
  margin-right: -6rpx;
  margin-left: -6rpx;
}
.delivery-files {
  border: 2rpx solid var(--ink-5);
  border-radius: 28rpx;
  box-shadow: 0 6rpx 24rpx var(--ink-5);
  overflow: hidden;
}

.delivery-file-row {
  height: 104rpx;
  padding: 0 40rpx;
  gap: 24rpx;
}

.delivery-file-icon {
  position: relative;
  width: 36rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.delivery-file-outline {
  position: absolute;
  left: -4rpx;
  font-size: 44rpx;
  line-height: 44rpx;
}

.delivery-file-line {
  position: absolute;
  left: 9rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background-color: var(--text);
}

.delivery-file-line-short {
  top: 23rpx;
  width: 8rpx;
}

.delivery-file-line-long {
  top: 30rpx;
  width: 14rpx;
}
.delivery-file-name {
  flex: 1;
  min-width: 0;
  line-height: 40rpx;
}
.delivery-file-arrow {
  flex-shrink: 0;
  line-height: 40rpx;
}

.delivery-file-divider {
  height: 2rpx;
  margin: 0 44rpx;
  background-color: var(--ink-5);
}
