/* Shared by the creation Try it sheet and the login prompt. */
.try-it-gesture,
.try-it-sheet {
  width: 100%;
  height: 100%;
}

.try-it-sheet {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  border-top-left-radius: 32px;
  border-top-right-radius: 32px;
  background: var(--bg-l0, #ffffff);
}

.try-it-hero {
  display: block;
  width: 100%;
  height: 300rpx;
  flex: 0 0 auto;
}

.try-it-close {
  position: absolute;
  z-index: 2;
  top: 28rpx;
  right: 28rpx;
  width: 92rpx;
  height: 92rpx;
  box-shadow: 0 0 26rpx rgba(0, 0, 0, 0.1);
}

.try-it-copy {
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  gap: 20rpx;
  padding: 41rpx 55rpx;
  box-sizing: border-box;
  text-align: center;
}

.try-it-title,
.try-it-description {
  display: block;
}

.try-it-title {
  color: var(--text-l0, #0d0d0d);
  font-size: 41rpx;
  line-height: 55rpx;
  font-weight: 600;
}

.try-it-description {
  color: var(--text-l1, #5d5d5d);
  font-size: 27rpx;
  line-height: 41rpx;
  font-weight: 400;
}

