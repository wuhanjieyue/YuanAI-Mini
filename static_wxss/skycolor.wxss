/* 背景颜色类 */
.bg-gray { background-color: var(--bg-gray); }
.bg-l0 { background-color: var(--bg-l0); }
.bg-l1 { background-color: var(--bg-l1); }
.bg-l2 { background-color: var(--bg-l2); }
.bg-l3 { background-color: var(--bg-l3); }
.bg-content { background-color: var(--bg-content); }
.bg-user-content { background-color: var(--bg-user-content); }
.accent-user-bubble {
  background-color: var(--accent-soft-bg);
  color: var(--accent-soft-text);
}
.main-l0 { background-color: var(--main-l0); }
.main-l1 { background-color: var(--main-l1); }
.main-l2 { background-color: var(--main-l2); }
