.text-r2 { color: var(--text-r2); }
.text-r3 { color: var(--text-r3); }
.text-strong { color: var(--text-strong); }
.text-main-l1 { color: var(--main-l1); }
.text-err-l1 { color: var(--err-l1); }
.text-link { color: var(--accent-link); }
.text-danger { color: var(--accent-danger-text); }
.text-muted { color: var(--text-muted); }
.text-hint { color: var(--text-hint); }
.text-placeholder { color: var(--text-placeholder); }

