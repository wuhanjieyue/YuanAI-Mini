/* 全局通用布局与容器 */
.full-view{
  width: 100vw;
  height: 100vh;
}

.glass-view{
  transform-origin: 50% 0;
  background: var(--glass-20, rgba(255, 255, 255, 0.2));
  border: 1px solid var(--glass-100, rgba(255, 255, 255, 1));
  backdrop-filter: blur(10px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.1);
}

