.safe-holder{
  height: 20vh;
}

/* 跨页面/组件复用的结构样式 */
.full-bg{
  position: absolute;
  top: 0;
  width: 100%;
  height: 100%;
}

.move-box{
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 99;
}

.move-line{
  width: 64rpx;
  height: 12rpx;
  background-color: var(--text-l2);
}

.sheet-scroll{
  height: 100%;
  margin: 0 auto;
  overflow: hidden;
  border-top-left-radius: 25px;
  border-top-right-radius: 25px;
}

.sheet-column{
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--surface-subtle, #f5f5f5);
  border-top-left-radius: 25px;
  border-top-right-radius: 25px;
}

.sheet-header-title{
  flex: 1;
  text-align: center;
  font-weight: 600;
}

.section-group{
  margin-top: 36rpx;
}

.section-group-first{
  margin-top: 0;
}

.section-title{
  display: block;
  margin: 0 12rpx 12rpx;
  color: var(--text-muted, #5f5d5a);
  font-size: 28rpx;
  font-weight: 600;
}

.section-hint{
  display: block;
  margin: 8rpx 12rpx 0;
  color: var(--text-hint);
  font-size: 24rpx;
  line-height: 1.65;
}

.section-card{
  width: 100%;
  background: var(--bg-l0, #ffffff);
  border-radius: 36rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.04);
}

/* 设置选项内容样式；定位和动画由 yb-flyout 管理。 */
.setting-option-pop-surface{
  background: var(--glass-72, rgba(255, 255, 255, 0.72));
  border: 2px solid var(--border-glass, #ffffff);
  border-radius: 20px;
  backdrop-filter: blur(10px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  padding: 6rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.setting-option-pop-surface::after{
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  background: var(--glass-10, rgba(255, 255, 255, 0.1));
  border-radius: inherit;
  filter: blur(2px) brightness(120%);
}

.setting-option-pop-list{
  min-height: 0;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.setting-option-pop-item{
  min-height: 92rpx;
  margin: 0 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.setting-option-check-slot{
  width: 48rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.setting-option-color-dot{
  width: 20rpx;
  height: 20rpx;
  margin-right: 16rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.setting-option-copy{
  flex: 1;
  min-width: 0;
}

.setting-option-desc{
  margin-top: 6rpx;
}

.setting-option-check{
  line-height: 1;
}

.row-title{
  font-weight: 500;
}

.row-arrow{
  margin-left: 12rpx;
}

.hint-link{
  color: var(--accent-link);
}

.input-placeholder{
  color: var(--text-placeholder);
}

.user-content{
  font-family: PingFang SC, Lantinghei SC, Microsoft Yahei, Hiragino Sans GB, Microsoft Sans Serif, WenQuanYi Micro Hei, sans-serif;
  font-weight: 300;
  font-size: 32rpx;
  line-height: 1.8;
}

.title-line{
  width: 100vw;
  height: 1rpx;
  background-color: var(--bg-l2);
  margin-top: auto;
}

/* Empty home feature views share the same layout. */
.feature-placeholder-page{
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background-color: var(--bg-gray, #F8F7F5);
}

.feature-placeholder-content{
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.feature-placeholder-title{
  color: var(--text-l0, #333333);
  font-size: 40rpx;
  font-weight: 600;
}

.feature-placeholder-hint{
  margin-top: 16rpx;
  color: var(--text-l1, #777777);
  font-size: 28rpx;
}

/* Help, terms, privacy and file-preview headers. */
.info-page{
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--bg-l0);
  color: var(--text-strong);
}

.info-toolbar{
  flex-shrink: 0;
  display: flex;
  align-items: center;
  min-height: 128rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.info-header-side{
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
}

.info-title{
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
  text-align: center;
  font-weight: 600;
}

.info-scroll{
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
  overflow: hidden;
}

.info-article{
  min-height: 100%;
  box-sizing: border-box;
  padding: 24rpx 36rpx calc(64rpx + env(safe-area-inset-bottom));
}

/* Search bar geometry shared by library and archived chats. */
.floating-search{
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 96rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--ink-12, rgba(0, 0, 0, 0.12));
  border-radius: 48rpx;
  background: var(--glass-94, rgba(255, 255, 255, 0.94));
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.08);
}

.floating-search-icon{
  font-size: 42rpx;
  margin-right: 20rpx;
  color: var(--text-strong, #1F1F1F);
}

.floating-search-input{
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  color: var(--text-strong, #1F1F1F);
}

.floating-search-placeholder{
  color: var(--text-muted, #8C8A87);
}

.floating-search-clear{
  position: absolute;
  top: 50%;
  right: 0;
  transform-origin: 100% 50%;
  width: 0;
  height: 0;
  overflow: hidden;
  border: 2rpx solid var(--ink-12, rgba(0, 0, 0, 0.12));
  border-radius: 50%;
  background: var(--glass-94, rgba(255, 255, 255, 0.94));
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  pointer-events: none;
}

.floating-search-clear-active{
  pointer-events: auto;
}

.floating-search-clear-icon{
  font-size: 40rpx;
  color: var(--text-strong, #1F1F1F);
}

.chat-unread-dot {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  background-color: var(--accent-action-bg);
}
