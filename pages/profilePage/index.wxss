.sheet {
  position: absolute;
  width: 100%;
  bottom: 0;
}
.profile-content {
  min-height: 100%;
  padding-right: 54rpx;
  padding-bottom: 80rpx;
  padding-left: 54rpx;
  box-sizing: border-box;
}

.avatar-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.profile-avatar-frame {
  width: 180rpx;
  height: 180rpx;
  overflow: hidden;
  background: var(--ink-8, rgba(0, 0, 0, 0.08));
}

.profile-avatar {
  width: 180rpx;
  height: auto;
  flex: 0 0 auto;
}

.avatar-edit {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 72rpx;
  height: 72rpx;
  background: var(--glass-76, rgba(255, 255, 255, 0.76));
  border: 2rpx solid var(--glass-95, rgba(255, 255, 255, 0.95));
  backdrop-filter: blur(12px);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.12);
}

.form-row {
  width: 100%;
}

.form-label {
  display: block;
  margin: 0 0 18rpx 34rpx;
}

.profile-input {
  width: 100%;
  height: 108rpx;
  padding: 0 34rpx;
  border: 2rpx solid var(--ink-12, rgba(0, 0, 0, 0.12));
  border-radius: 54rpx;
  font-size: 34rpx;
  box-sizing: border-box;
  background: var(--glass-42, rgba(255, 255, 255, 0.42));
}
.save-btn {
  min-width: 380rpx;
  height: 104rpx;
  padding: 0 54rpx;
  border-radius: 54rpx;
  font-size: 34rpx;
  background: var(--control-strong, #050505);
  box-sizing: border-box;
}

.cancel-btn {
  font-size: 34rpx;
}
