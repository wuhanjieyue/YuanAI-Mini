@import "/static_wxss/asset-cards.wxss";
/* pages/leftpage/index.wxss */
@import '/static_wxss/skeleton.wxss';
@import '/static_wxss/drawer-card.wxss';
page { background-color: transparent; }
.drawer-shell { position: relative; }
.drawer-page-background {
  position: absolute;
  left: 0;
  top: 0;
  opacity: 0;
  border-color: transparent;
  /* 填满主卡片圆角外侧，内部继续显示首页内容。 */
  box-shadow: 0 0 0 100vw var(--bg-gray);
  pointer-events: none;
}
.drawer-viewport {
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  overflow: hidden;
}
.drawer-close-area {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  opacity: 0;
  pointer-events: none;
}
.drawer-close-hitbox {
  position: absolute;
  right: 0;
  top: 0;
  width: 0;
  height: 100vh;
  z-index: 2;
}
.leftview {
  position: absolute;
  left: -50vw;
  top: 0;
  z-index: 0;
  opacity: 0;
}
.conversation-preview {
  position: relative;
  width: 100%;
  height: 100%;
}

.conversation-preview-messages {
  flex-shrink: 0;
  padding: 12rpx 0;
  pointer-events: none;
}

.conversation-preview-empty {
  height: 100%;
}
.conversation-preview-loading {
  gap: 20rpx;
  overflow: hidden;
  pointer-events: none;
}

.conversation-preview-skeleton {
  flex-shrink: 0;
  width: 82%;
  padding: 18rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.conversation-preview-skeleton-user {
  align-self: flex-end;
  width: 64%;
}

.conversation-preview-skeleton-line {
  height: 20rpx;
  border-radius: 6rpx;
}

.conversation-preview-skeleton-short {
  width: 60%;
  margin-top: 12rpx;
}
