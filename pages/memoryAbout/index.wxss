.memory-about-sheet {
  position: absolute;
  bottom: 0;
  width: 100%;
}
.memory-about-scroll {
  width: 100%;
  height: 100%;
  border-radius: 32px 32px 0 0;
  overflow: hidden;
}

.memory-about-card {
  width: 100%;
  padding: 44rpx 48rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.memory-about-title {
  flex-shrink: 0;
  font-size: 38rpx;
  line-height: 1.4;
}
.memory-about-description {
  flex-shrink: 0;
  width: 80%;
  line-height: 1.55;
}

.memory-about-button {
  flex-shrink: 0;
  width: 100%;
  height: 92rpx;
  margin-top: auto;
  border-radius: 999px;
  background: var(--accent-action-bg, #111111);
}
.memory-about-button-text {
  color: var(--accent-action-text, #ffffff);
}
