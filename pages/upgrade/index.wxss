@import '/static_wxss/skycolor.wxss';
@import '/static_wxss/skyother.wxss';
@import '/static_wxss/skyfontline.wxss';

.upgrade-close{
  width: 92rpx;
  height: 92rpx;
}

.upgrade-content{
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
}
.upgrade-hero {
  padding: 28rpx 54rpx 54rpx;
}

.upgrade-logo{
  width: 116rpx;
  height: 116rpx;
}
.upgrade-title {
  margin-top: 38rpx;
  line-height: 80rpx;
}
.upgrade-intro {
  margin-right: 62rpx;
  margin-bottom: 34rpx;
  margin-left: 62rpx;
  font-size: 26rpx;
  line-height: 42rpx;
}
.upgrade-benefit {
  min-height: 62rpx;
  margin-top: 0;
  margin-right: 62rpx;
  margin-left: 62rpx;
}
.upgrade-check {
  flex-shrink: 0;
  width: 38rpx;
  font-size: 38rpx;
  line-height: 50rpx;
}
.upgrade-benefit-text {
  flex: 1;
  min-width: 0;
  line-height: 50rpx;
}

.upgrade-actions{
  flex-shrink: 0;
  padding: 42rpx 54rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.upgrade-pressed{
  opacity: 0.82;
}
