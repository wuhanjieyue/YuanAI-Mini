<page-meta page-style="{{themeStyle}}" root-background-color="#ffffff00" />
<view class="full-bg" bind:tap="closePage" style="{{themeStyle}}"></view>

<draggable-sheet
    class="sheet"
    initial-child-size="{{0.5}}"
    min-child-size="{{0}}"
    max-child-size="{{1}}"
    snap="{{true}}"
    snap-sizes="{{[0.5, 1]}}"
    worklet:onsizeupdate="onSizeUpdate"
     style="{{themeStyle}}">
      <view class="move-box dc ac">
          <view class="move-bg dc ac ptb24">
            <view class="sradius move-line" ></view>
          </view>
        </view>
      <scroll-view
      associative-container="draggable-sheet"
      class="scrollable sheet-scroll glass"
      scroll-y
      type="list"
      show-scrollbar="{{false}}"
      >


        <view wx:if="{{utilsLoading}}" list-item class="ptb48 plr36 text-l2 ft24">{{i18n.common.loading}}</view>
        <view wx:elif="{{utilsFailed}}" list-item class="asset-failure-state ptb48 plr36" bind:tap="loadEnabledSkills" aria-role="button"><image class="asset-empty-logo" src="/static/logs/glog.png" mode="aspectFit" aria-hidden="true" /><text class="asset-empty-copy">{{i18n.common.loadFailed}} · {{i18n.common.retry}}</text></view>
        <view wx:elif="{{!utils.length}}" list-item class="ptb48 plr36 text-l2 ft24">{{i18n.plugins.empty}}</view>
        <view wx:for="{{utils}}" wx:key="id" list-item data-id="{{item.id}}" bind:tap="selectUtil" aria-role="button" aria-label="{{item.name}}" class="dr ac plr36 mb48 {{index == 0 ? 'mt48' : ''}}  {{model == item.id ? 'text-main-l1' :''}}" >
          <image class="util-logo" src="{{item.logoUrl}}" mode="aspectFill" aria-hidden="true" />
          <view class="ml36 util-copy">
            <text class="ft32 mb8" max-lines="1" overflow="ellipsis">{{item.name}}</text>
            <text class="ft24 {{model == item.id ? 'text-main-l1' :'text-l2'}}" max-lines="1" overflow="ellipsis">{{item.tip}}</text>
          </view>
          <text class="iconfont icon-check mla ft48" wx:if="{{model == item.id}}"></text>

        </view>
      </scroll-view>
</draggable-sheet>
