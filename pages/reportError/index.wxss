.header{
  flex-shrink: 0;
  background: linear-gradient(to bottom, var(--glass-95, rgba(245,245,245,0.95)), rgba(245,245,245,0));
}

.scrollable{
  flex: 1;
  overflow: hidden;
}
.content {
  padding-top: 12rpx;
}
.label {
  display: block;
}
.textarea-box {
  width: 100%;
  padding-right: 28rpx;
  padding-left: 28rpx;
  box-sizing: border-box;
  position: relative;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.04);
}

.textarea-control{
  width: 100%;
  height: 280rpx;
  line-height: 1.6;
}
.char-count {
  display: block;
  text-align: right;
}

.hint{
  display: block;
  margin: 20rpx 0;
  line-height: 1.65;
}

.divider{
  width: 100%;
  height: 1rpx;
  background: var(--ink-8, rgba(0,0,0,0.08));
}

.option-row{
  padding: 28rpx 0;
}

.bottom-bar{
  flex-shrink: 0;
  padding-top: 12rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.send-btn{
  width: 100%;
  height: 96rpx;
  background: var(--ink-12, rgba(0,0,0,0.12));
}

.send-btn.active{
  background: var(--control-strong, #1f1f1f);
}

.file-icon{
  width: 92rpx;
  height: 92rpx;
}

page { background-color: transparent; }
.report-sheet { position: absolute; bottom: 0; width: 100%; }
.report-panel { height: 100%; width: 95%; margin: 0 auto; border-radius: 32px 32px 0 0; overflow: hidden; display: flex; flex-direction: column; box-sizing: border-box; }
.report-scroll { flex: 1; height: 0; min-height: 0; width: 100%; }
.report-card { box-sizing: border-box; padding-bottom: 16rpx; }
.report-prompt-card { padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }
.prompt-description { display: block; line-height: 1.6; margin: 24rpx 0 36rpx; }

.report-panel-stacked { width: 100%; margin: 0; border-radius: 0; }
