@import '/static_wxss/drawer-card.wxss';

.home-shell,
.full-page,
.home-feature{
  position: relative;
}

.leftview{
  position: absolute;
  left: -50vw;
  top: 0;
  z-index: 0;
  opacity: 0;
}

.rightview {
  overflow: hidden;
}
.drawer-home-close {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  opacity: 0;
  pointer-events: none;
}

.home-feature{
  position: absolute;
  left: 0;
  top: 0;
}
