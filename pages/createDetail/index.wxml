<page-meta page-style="{{themeStyle}}" root-background-color="transparent" />
<view class="full-bg" bind:tap="closePage" style="{{themeStyle}}"></view>
<draggable-sheet class="creation-sheet" style="{{themeStyle + ';' + accentStyle + ';height:' + screenHeight + 'px;'}}"
  initial-child-size="{{sheetSize}}" min-child-size="{{0}}" max-child-size="{{sheetSize}}"
  snap="{{true}}" worklet:onsizeupdate="onSizeUpdate">
  <scroll-view class="creation-scroll bg-l0" type="list" scroll-y show-scrollbar="{{false}}" associative-container="draggable-sheet">
    <view class="creation-hero ac jc bg-l1" style="height:{{screenHeight * 0.36}}px;">
      <image wx:if="{{item.url && !imageFailed}}" class="creation-image" src="{{item.url}}" mode="aspectFill" bind:error="imageFailed" show-menu-by-longpress="{{false}}" />
      <text wx:else class="text-l2">{{imageFailed ? i18n.assets.imageUnavailable : i18n.common.loading}}</text>
    </view>
    <view class="creation-copy tc pt32">
      <text class="creation-title wt6 text-l0" max-lines="2" overflow="ellipsis">{{item.title}}</text>
      <text class="creation-prompt ft28 text-l2" max-lines="3" overflow="ellipsis">{{item.prompt || i18n.create.noPrompt}}</text>
      <block wx:if="{{item.prompt && item.supportsImageInput}}">
        <view style="width:100%;" hover-class="creation-prompt-button-pressed" hover-start-time="20" hover-stay-time="70"><button class="creation-prompt-button creation-photo-button" hover-class="none" data-source="camera" bind:tap="choosePhoto" style="width:100%;height:92rpx;margin:32rpx 0 0;padding:0;border-radius:999px;color:var(--text-l0);background:transparent;font-size:28rpx;line-height:92rpx;font-weight:500;border:2rpx solid var(--border-subtle);" plain="{{true}}">{{i18n.create.takePhoto}}</button></view>
        <view style="width:100%;" hover-class="creation-prompt-button-pressed" hover-start-time="20" hover-stay-time="70"><button class="creation-prompt-button creation-photo-choose" hover-class="none" data-source="album" bind:tap="choosePhoto" style="width:100%;height:92rpx;margin:32rpx 0 0;padding:0;border-radius:999px;color:var(--accent-action-text, #FFFFFF);background:var(--accent-action-bg, rgba(0, 0, 0, 0.9));font-size:28rpx;line-height:92rpx;font-weight:500;margin-top:24rpx;border:0;" plain="{{true}}">{{i18n.create.choosePhoto}}</button></view>
      </block>
      <view wx:elif="{{item.prompt}}" style="width:100%;" hover-class="creation-prompt-button-pressed" hover-start-time="20" hover-stay-time="70"><button class="creation-prompt-button" hover-class="none" bind:tap="tryPrompt" style="width:100%;height:92rpx;margin:32rpx 0 0;padding:0;border-radius:999px;color:var(--accent-action-text, #FFFFFF);background:var(--accent-action-bg, rgba(0, 0, 0, 0.9));font-size:28rpx;line-height:92rpx;font-weight:500;border:0;" plain="{{true}}">{{i18n.create.tryPrompt}}</button></view>
    </view>
  </scroll-view>
  <view class="creation-toolbar dr ac">
    <view class="creation-tool dc ac jc glass-view cradius" bind:tap="shareImage" aria-role="button" aria-label="{{i18n.chat.share}}" aria-disabled="{{sharing}}">
      <text class="iconfont icon-share ft48 text-l0"></text>
    </view>
    <view class="creation-tool dc ac jc glass-view cradius" bind:tap="closePage" aria-role="button" aria-label="{{i18n.archive.close}}">
      <text class="iconfont icon-x ft48 text-l0"></text>
    </view>
  </view>
</draggable-sheet>
<yb-notice-capsule id="errorNotice" notice="{{errorNotice}}" duration="{{2500}}" closable="{{true}}" alert="{{true}}" theme-style="{{themeStyle}};{{accentStyle}}" close-label="{{i18n.common.close}}" />
