page { background-color: transparent; }

.creation-sheet {
  position: absolute;
  bottom: 0;
  width: 100%;
}
.creation-scroll {
  width: 100%;
  height: 100%;
  border-radius: 32px 32px 0 0;
  overflow: hidden;
}
.creation-hero {
  display: flex;
}
.creation-image { width: 100%; height: 100%; }
.creation-toolbar {
  position: absolute;
  top: 28rpx;
  right: 5%;
  gap: 16rpx;
}
.creation-tool { width: 92rpx; height: 92rpx; }
.creation-copy {
  padding-right: 100rpx;
  padding-bottom: 32rpx;
  padding-left: 100rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.creation-title {
  display: block;
  font-size: 38rpx;
  line-height: 50rpx;
}
.creation-prompt {
  display: block;
  margin-top: 20rpx;
  line-height: 42rpx;
}
.creation-prompt-button-pressed { opacity: 0.82; }
